{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "App",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "run",
                "app/main.py",
                "--server.port=8501",
                "--server.headless=true"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Run Extraction (Valencia)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/extraction/run_extraction.py",
            "args": ["--source", "idealista", "--city", "valencia", "--dry-run"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Pytest",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "pytest",
            "args": ["-v", "extraction/tests/"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ]
}