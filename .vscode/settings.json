{
    // ── Python ────────────────────────────────────────────────────────────────
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,

    // ── Formatting ────────────────────────────────────────────────────────────
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "[sql]": {
        "editor.defaultFormatter": "dorzey.vscode-sqlfluff"
    },
    "black-formatter.args": ["--line-length", "100"],

    // ── Linting ───────────────────────────────────────────────────────────────
    "ruff.args": ["--line-length", "100"],
    "python.linting.enabled": true,

    // ── Testing ───────────────────────────────────────────────────────────────
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["extraction/tests"],

    // ── dbt Power User (install the extension for autocomplete) ───────────────
    "dbt.dbtPythonPathOverride": "${workspaceFolder}/.venv/bin/python",

    // ── WSL / file watching ───────────────────────────────────────────────────
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/transform/target/**": true,
        "**/transform/dbt_packages/**": true
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true
    },

    // ── Recommended extensions (will prompt team to install) ──────────────────
    "extensions.ignoreRecommendations": false
}
