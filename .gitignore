# ── Secrets ───────────────────────────────────────────────────────────────────
.env
*.token

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# ── dbt ───────────────────────────────────────────────────────────────────────
# per-developer dbt config — copied from profiles.yml.example by `make install`
transform/profiles.yml
# dbt writes a per-developer anonymous id here on first run; it identifies the
# machine, not the project, so it has no business being shared.
transform/.user.yml
transform/target/
transform/dbt_packages/
transform/logs/
# dbt writes here when invoked from repo root
logs/

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── VSCode ────────────────────────────────────────────────────────────────────
# launch.json, settings.json and extensions.json are all committed on purpose:
# CONTRIBUTING links to extensions.json as the list VSCode offers to install on
# first open, and an ignored file makes that link dead in a fresh clone.

# ── OS / WSL ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp

# ── Data / raw files ──────────────────────────────────────────────────────────
data/
*.duckdb
debug_output/