# Template for Streamlit secrets.
# LOCAL: copy to `.streamlit/secrets.toml` (gitignored) OR just use the root `.env`.
# STREAMLIT COMMUNITY CLOUD: paste these keys into the app's "Secrets" settings.
#
# connection.py reads these via st.secrets first, then falls back to os.environ,
# so the same code works locally (.env) and on Streamlit Cloud (this file / UI).

MOTHERDUCK_TOKEN = "your-motherduck-token-here"
MOTHERDUCK_DATABASE = "spanish_housing_radar"
