# Template for local configuration. `make install` copies this to `.env`, which
# is git-ignored. Every value below is a default that works without editing,
# except the two secrets at the top — the app and the extractors will not run
# until MOTHERDUCK_TOKEN is real.
#
# Streamlit Community Cloud has no .env: there the same keys go into the app's
# Secrets UI (see .streamlit/secrets.toml.example). app/connection.py reads
# st.secrets first and falls back to the environment, so one codebase covers both.

# ── MotherDuck (required) ─────────────────────────────────────────────────────
# Free token from https://app.motherduck.com → Settings → Access Tokens.
# extraction/config.py reads this at import time and raises without it, so even
# the unit tests need *something* here (CI passes a placeholder).
MOTHERDUCK_TOKEN=your-motherduck-token-here
MOTHERDUCK_DATABASE=spanish_housing_radar

# ── Scrapfly (only needed to scrape listings) ─────────────────────────────────
# Leave SCRAPFLY_ENABLED=false to work against whatever is already in the
# warehouse: the INE feed, dbt and the whole app run without a Scrapfly key.
#
# Before setting this to true, read docs/adr/0001-search-card-scraping.md.
# Scrapfly bills a FLAT 25 credits per search page because Idealista requires
# anti-bot protection, so the 1,000-credit free month is exactly 40 pages.
SCRAPFLY_ENABLED=false
SCRAPFLY_API_KEY=your-scrapfly-key-here

# asp=true is what costs the 25 credits, and it is not optional for Idealista —
# without it the response is a DataDome challenge page, not listings.
SCRAPFLY_ASP=true
SCRAPFLY_COUNTRY=ES
# Search cards are server-rendered, so JS rendering buys nothing and costs more.
SCRAPFLY_RENDER_JS=false

# Hard ceiling on credits ONE PROCESS may spend before it stops itself
# (extraction/scrapers/base.py). 0 = no ceiling. The scheduled run sets 125.
SCRAPFLY_CREDIT_BUDGET=0

# ── Scrape scope ──────────────────────────────────────────────────────────────
# 1 page ≈ 30 listings ≈ 25 credits. These are per source, per run.
IDEALISTA_MAX_SEARCH_PAGES=1
IDEALISTA_MAX_LISTINGS=50
FOTOCASA_MAX_SEARCH_PAGES=1
FOTOCASA_MAX_LISTINGS=30

# ── Scraper manners ───────────────────────────────────────────────────────────
SCRAPER_DELAY_SECONDS=2
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_SECONDS=30

# ── INE (free, keyless — no credits, no account) ──────────────────────────────
# Tempus3 JSON API. Table 25171 is the Índice de Precios de Vivienda (IPV).
INE_BASE_URL=https://servicios.ine.es/wstempus/js/ES
INE_HPI_TABLE_ID=25171
INE_HPI_N_PERIODS=16
INE_TIMEOUT_SECONDS=30

# ── dbt ───────────────────────────────────────────────────────────────────────
# The Makefile and CI pass --project-dir from the repo root and set
# DBT_PROFILES_DIR themselves; this is here for bare `dbt` invocations.
DBT_PROFILES_DIR=./transform
DBT_TARGET=dev
