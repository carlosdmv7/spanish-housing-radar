# Keep the image lean and secrets out of the build context.
.env
.env.*
.git/
.github/
.venv/
.streamlit/
app/
**/__pycache__/
**/.pytest_cache/
transform/target/
transform/dbt_packages/
transform/logs/
*.md
# ...but pyproject.toml declares `readme = "README.md"`, so the build context
# must keep it or `COPY pyproject.toml uv.lock README.md ./` fails to resolve.
!README.md
data/
notebooks/
